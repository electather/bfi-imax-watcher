# Copy to .env and fill in. Never commit .env (it is gitignored).

# --- Required ---
# Telegram bot token from @BotFather (see README).
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz
# Chat to notify: your numeric user id, or a group/channel id (see README).
TELEGRAM_CHAT_ID=123456789

# --- Optional (defaults shown) ---
# Page to watch.
TARGET_URL=https://whatson.bfi.org.uk/imax/Online/default.asp?BOparam::WScontent::loadArticle::permalink=odyssey-the-film-imax-70mm-2026
# Seconds between checks (900 = 15 minutes). Lower it as the on-sale date nears.
CHECK_INTERVAL=900
# Run Chromium headless. Keep true in Docker.
HEADLESS=true
# Send an error alert after this many consecutive unreadable checks.
ERROR_ALERT_AFTER=5
# Where alerted showtimes are persisted (must sit on the mounted volume).
STATE_FILE=/data/last_status.json

# --- Optional: only watch showtimes of interest (OVERRIDES the built-in defaults) ---
# Built-in defaults (used when none of the WATCH_* vars below are set):
#   rules: weekends at prime times OR any weekday evening after 6pm
#          = sat,sun@12:00-13:00,16:00-17:00,19:30-21:00;mon-fri@18:00-23:59
#   dates: 2026-07-17 .. 2026-08-13
# A separate alert fires per distinct matching showtime, with its booking link.
#
# WATCH_RULES is the flexible option: one or more rules separated by ";", each
# "DAYS@TIMES". Rules are ORed, so different days can carry different time
# windows. DAYS = comma list of weekday names/abbreviations, with ranges like
# "mon-fri". TIMES = comma list of HH:MM (exact) or HH:MM-HH:MM (inclusive).
# Omit "DAYS@" for any day; omit "@TIMES" (write "DAYS@") for any time.
# WATCH_RULES=sat,sun@12:00-13:00,16:00-17:00,19:30-21:00;mon-fri@18:00-23:59
#
# Simple alternative (one rule): WATCH_TIMES + WATCH_DAYS, ANDed together.
# Both contribute a single rule that is ORed with any WATCH_RULES groups.
# Setting any of WATCH_RULES/WATCH_TIMES/WATCH_DAYS replaces the default rules.
# WATCH_TIMES=11:30,18:00-22:00
# WATCH_DAYS=sat,sun
#
# Inclusive ISO date bounds (YYYY-MM-DD); each overrides its default
# independently.
# WATCH_DATE_FROM=2026-07-17
# WATCH_DATE_TO=2026-08-13

# --- Optional detector tuning (comma-separated; defaults are built in) ---
# Override only if the real bookable/sold-out/coming-soon markup differs from
# defaults. Defaults target BFI's AudienceView widget; see src/detector.ts.
# BOOKABLE_KEYWORDS=aria-label="buy,,buy tickets,book tickets
# COMING_SOON_KEYWORDS=coming soon,on sale soon,not yet on sale
# SOLD_OUT_KEYWORDS=class="unavailable-message">sold out,last-column soldout
# BOOKING_LINK_PATTERNS=last-column\s+(?:excellent|good|limited)\b,mapselect\.asp
